rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Hardened admin check:
    // Requires authenticated user with email_verified == true
    // Matches primary bootstrap owner email, or an email in /adminEmails, or UID in /admins
    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email_verified == true
        && (
          (request.auth.token.email != null && request.auth.token.email.lower() == 'aa525458516@gmail.com')
          || (request.auth.token.email != null && exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email.lower())))
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidBookingCreate(data) {
      return data.keys().hasAll(['bookingReference', 'customerName', 'phone', 'email', 'passengerCount', 'pickupDate', 'destination', 'status'])
        && data.status == 'Pending'
        && data.bookingReference is string && data.bookingReference.size() <= 40
        && data.customerName is string && data.customerName.size() > 1 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 100
        && data.passengerCount is int && data.passengerCount >= 1
        && (!('vehicleType' in data) || (data.vehicleType is string && data.vehicleType.size() <= 60))
        && (('vehicleType' in data && data.vehicleType == 'toyota_hiace' && data.passengerCount <= 8) || data.passengerCount <= 4)
        && data.pickupDate is string && data.pickupDate.size() <= 30
        && data.destination is string && data.destination.size() <= 200;
    }

    function isValidPublicStatusCreate(data) {
      return data.keys().hasAll(['bookingReference', 'status', 'pickupDate', 'destination', 'verifyEmailHash', 'verifyPhoneHash'])
        && data.status == 'Pending'
        && data.bookingReference is string && data.bookingReference.size() <= 40
        && data.verifyEmailHash is string && data.verifyEmailHash.size() == 64 && data.verifyEmailHash.matches('^[a-f0-9]{64}$')
        && data.verifyPhoneHash is string && data.verifyPhoneHash.size() == 64 && data.verifyPhoneHash.matches('^[a-f0-9]{64}$')
        && (!('customerName' in data))
        && (!('phone' in data))
        && (!('email' in data))
        && (!('emailHash' in data))
        && (!('phoneHash' in data))
        && (!('adminNotes' in data));
    }

    function isValidCustomTripCreate(data) {
      return data.keys().hasAll(['referenceNumber', 'customerName', 'phone', 'email', 'passengerCount', 'startDate', 'status'])
        && data.status == 'Pending Review'
        && data.referenceNumber is string && data.referenceNumber.size() <= 40
        && data.customerName is string && data.customerName.size() > 1 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 50
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 100
        && data.passengerCount is int && data.passengerCount >= 1 && data.passengerCount <= 4
        && (!('pricing' in data) || (!('internalCost' in data.pricing) && !('margin' in data.pricing)));
    }

    function isValidCustomTripStatusCreate(data) {
      return data.keys().hasAll(['referenceNumber', 'maskedCustomerName', 'startDate', 'passengerCount', 'pickup', 'accommodation', 'status', 'verifyEmailHash', 'verifyPhoneHash'])
        && data.status == 'Pending Review'
        && data.referenceNumber is string && data.referenceNumber.size() <= 40
        && data.maskedCustomerName is string && data.maskedCustomerName.size() >= 1 && data.maskedCustomerName.size() <= 100
        && data.passengerCount is int && data.passengerCount >= 1 && data.passengerCount <= 4
        && data.verifyEmailHash is string && data.verifyEmailHash.size() == 64 && data.verifyEmailHash.matches('^[a-f0-9]{64}$')
        && data.verifyPhoneHash is string && data.verifyPhoneHash.size() == 64 && data.verifyPhoneHash.matches('^[a-f0-9]{64}$')
        && (!('customerName' in data))
        && (!('phone' in data))
        && (!('email' in data))
        && (!('country' in data))
        && (!('specialRequests' in data))
        && (!('emailHash' in data))
        && (!('phoneHash' in data))
        && (!('adminNotes' in data))
        && (!('pricing' in data) || (!('internalCost' in data.pricing) && !('margin' in data.pricing)));
    }

    function isValidMessageCreate(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'status'])
        && (data.status == 'unread' || data.status == 'pending')
        && data.name is string && data.name.size() > 1 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 100
        && data.message is string && data.message.size() > 1 && data.message.size() <= 2000;
    }

    // Admins collections: strictly accessible by verified administrators only
    match /admins/{adminUid} {
      allow read, write: if isValidId(adminUid) && isAdmin();
    }

    match /adminEmails/{emailKey} {
      allow read, write: if isAdmin();
    }

    // Confidential Master Bookings
    // Public CANNOT read or list documents.
    // Only verified administrators have access.
    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(bookingId) && isValidBookingCreate(incoming());
      allow update: if isValidId(bookingId) && isAdmin();
      allow delete: if isValidId(bookingId) && isAdmin();
    }

    // Sanitized Public Booking Status Card
    // Individual customers can ONLY get their own document by ID (= unguessable bookingReference)
    // and client UI enforces matching salted SHA-256 email/phone verification.
    // Listing/scraping is blocked for non-admins.
    match /bookingStatus/{refId} {
      allow get: if isValidId(refId);
      allow list: if isAdmin();
      allow create: if isValidId(refId) && isValidPublicStatusCreate(incoming());
      allow update: if isValidId(refId) && isAdmin();
      allow delete: if isValidId(refId) && isAdmin();
    }

    // Confidential Custom Trip Requests (Admin only for reads)
    // Public CANNOT read or list documents containing customer PII.
    match /customTripRequests/{requestId} {
      allow get: if isValidId(requestId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(requestId) && isValidCustomTripCreate(incoming());
      allow update: if isValidId(requestId) && (
        isAdmin() ||
        (resource.data.status == 'Price Sent' && incoming().status == 'Customer Approved' && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isValidId(requestId) && isAdmin();
    }

    // Sanitized Public Custom Trip Status Card
    // Zero PII (maskedCustomerName only), verified on lookup via salted SHA-256 hashes.
    match /customTripStatus/{refId} {
      allow get: if isValidId(refId);
      allow list: if isAdmin();
      allow create: if isValidId(refId) && isValidCustomTripStatusCreate(incoming());
      allow update: if isValidId(refId) && (
        isAdmin() ||
        (resource.data.status == 'Price Sent' && incoming().status == 'Customer Approved' && incoming().diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isValidId(refId) && isAdmin();
    }

    // Admin-Only Pricing for Custom Trips
    // Strictly forbidden for public access.
    match /customTripAdminPricing/{refId} {
      allow read, write: if isValidId(refId) && isAdmin();
    }

    // Tours Catalog
    match /tours/{tourId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tourId) && isAdmin();
    }

    // Tourist Destinations & Landmarks
    match /destinations/{destId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(destId) && isAdmin();
    }

    // Contact Messages
    match /contactMessages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessageCreate(incoming());
      allow get, list, update, delete: if isValidId(messageId) && isAdmin();
    }

    // Company Settings & Policies
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }
  }
}
